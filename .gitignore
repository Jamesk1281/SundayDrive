data/
# ...and `data` with no slash, which is what a git worktree needs: `data/` lives
# only in the main checkout, so working in a worktree means symlinking it in, and
# a symlink is not a directory as far as the pattern above is concerned. Without
# this line a `git add -A` from a worktree commits an absolute path off someone's
# desktop.
/data
out/
.venv/

# Drive traces copied off a phone (see tools/analyze_trace.py). These are a
# record of where someone actually drove, timestamped to the second — never
# commit them, whatever the analysis turns up.
traces/
*.ndjson
__pycache__/
*.pyc
.DS_Store

# editor/OS cruft
.claude/launch.json
*.log

# iOS build artifacts (xcodeproj regenerated from project.yml)
ios/build/
ios/VictoryLap.xcodeproj/
# Left behind by the rename: xcodegen emits a project named after the
# target, so an existing checkout keeps the old directory until it is
# deleted. Ignored so nobody commits it; delete it — two projects in
# ios/ is how Xcode opens the stale one.
ios/Scenic.xcodeproj/
ios/Generated/
ios/DerivedData/
*.xcuserstate
