+++ b/ios/Tests/ReplayDumpTests.swift
@@ -0,0 +1,28 @@
+import XCTest
+@testable import SundayDrive
+
+/// Mid-drive recovery study: replay every recorded drive and dump what it
+/// did, for a diff between the base build and the prototype. Scratch only.
+@MainActor
+final class ReplayDumpTests: XCTestCase {
+    func test_dump_replays() async throws {
+        let drives = DriveReplay.recordings()
+        guard !drives.isEmpty else { throw XCTSkip("no traces") }
+        let out = ProcessInfo.processInfo.environment["SUNDAYDRIVE_REPLAY_OUT"]
+            ?? NSTemporaryDirectory() + "replay-dump.ndjson"
+        var text = ""
+        for (i, drive) in drives.enumerated() {
+            let speaker = VoiceGuideTests.FakeSpeaker()
+            let o = await DriveReplay.run(drive, speaker: speaker)
+            var row: [String: Any] = [
+                "i": i, "arrived": o.arrived, "fixes": o.fixesFed, "replies": o.repliesGiven,
+                "same": o.sameLineReplies, "describable": o.describableFixes,
+                "repeats": o.repeatsWithoutARouteChange.count, "said": o.said,
+            ]
+            //WRONGWAY
+            let data = try JSONSerialization.data(withJSONObject: row, options: [.sortedKeys])
+            text += String(decoding: data, as: UTF8.self) + "\n"
+        }
+        try text.write(toFile: out, atomically: true, encoding: .utf8)
+    }
+}
