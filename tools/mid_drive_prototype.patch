+/// Every pass of the line within `within` metres of a point: for each run of
+/// adjacent segments that come that close, the nearest one's along-distance,
+/// offset and bearing. A run is split where the line itself turns back (a
+/// planned U-turn), so the two legs of one stay two passes.
+func passes(of point: CLLocationCoordinate2D, along line: [CLLocationCoordinate2D],
+            within: Double, notAfter: Double = .infinity)
+    -> [(along: Double, offset: Double, bearing: Double)] {
+    guard line.count >= 2 else { return [] }
+    let mLat = 111_320.0
+    var out: [(along: Double, offset: Double, bearing: Double)] = []
+    var travelled = 0.0
+    var run: (along: Double, offset: Double, bearing: Double)?
+    var lastHit = -2
+    var lastBearing = 0.0
+    for i in 0 ..< line.count - 1 {
+        if travelled > notAfter { break }
+        let p = line[i], q = line[i + 1]
+        let mLon = 111_320.0 * cos((p.latitude + q.latitude) / 2 * .pi / 180)
+        let ax = (p.longitude - point.longitude) * mLon, ay = (p.latitude - point.latitude) * mLat
+        let bx = (q.longitude - point.longitude) * mLon, by = (q.latitude - point.latitude) * mLat
+        let dx = bx - ax, dy = by - ay
+        let len2 = dx * dx + dy * dy, len = len2.squareRoot()
+        if len > 0 {
+            let t = max(0, min(1, -(ax * dx + ay * dy) / len2))
+            let cx = ax + t * dx, cy = ay + t * dy
+            let d = (cx * cx + cy * cy).squareRoot()
+            if d <= within {
+                let bearing = (atan2(dx, dy) * 180 / .pi + 360).truncatingRemainder(dividingBy: 360)
+                var turn = abs(bearing - lastBearing).truncatingRemainder(dividingBy: 360)
+                if turn > 180 { turn = 360 - turn }
+                let cand = (along: travelled + t * len, offset: d, bearing: bearing)
+                if i == lastHit + 1, turn < 120, let r = run {
+                    if d < r.offset { run = cand }
+                } else {
+                    if let r = run { out.append(r) }
+                    run = cand
+                }
+                lastHit = i
+                lastBearing = bearing
+            }
+        }
+        travelled += len
+    }
+    if let r = run { out.append(r) }
+    return out
+}
