+import CoreLocation
+import SwiftUI
+import UIKit
+import XCTest
+@testable import SundayDrive
+
+/// Mid-drive recovery study: the prototype's banner states, rendered from the
+/// real `NavView` on a fixture route, for the plan. Scratch only.
+@MainActor
+final class BannerShotTests: XCTestCase {
+
+    private var out: URL {
+        URL(fileURLWithPath: ProcessInfo.processInfo.environment["SUNDAYDRIVE_SHOTS"]
+            ?? NSTemporaryDirectory())
+    }
+
+    private func render(_ nav: NavigationModel, _ name: String) throws {
+        let view = NavView(nav: nav, locationManager: LocationManager(),
+                           destinationName: "Test", onEnd: {})
+        let host = UIHostingController(rootView: view)
+        let scene = UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }.first!
+        let window = UIWindow(windowScene: scene)
+        window.frame = CGRect(x: 0, y: 0, width: 402, height: 874)
+        window.windowLevel = .alert + 1
+        window.rootViewController = host
+        window.makeKeyAndVisible()
+        RunLoop.main.run(until: Date().addingTimeInterval(2))
+        let image = UIGraphicsImageRenderer(bounds: window.bounds).image { _ in
+            window.drawHierarchy(in: window.bounds, afterScreenUpdates: true)
+        }
+        try image.pngData()!.write(to: out.appendingPathComponent(name + ".png"))
+        let text = NavView.bannerText(nav: nav, location: LocationManager())
+        print("SHOT \(name): [\(text.over)] \(text.main)")
+        window.isHidden = true
+    }
+
+    private var clock = Date(timeIntervalSince1970: 1_790_000_000)
+
+    private func model(_ fail: Error, reachable: Bool) -> NavigationModel {
+        let nav = NavigationModel(route: Fixture.routeWithRoadNames(), destination: Fixture.north(5000),
+                                  pref: 0.5, weights: [:])
+        nav.now = { [unowned self] in self.clock }
+        nav.fetchRoute = { _, _, _, _, _ in throw fail }
+        nav.networkReachable = { reachable }
+        return nav
+    }
+
+    private func feed(_ nav: NavigationModel, _ fix: CLLocation) async {
+        clock = clock.addingTimeInterval(1)
+        let f = CLLocation(coordinate: fix.coordinate, altitude: 0, horizontalAccuracy: 5,
+                           verticalAccuracy: 5, course: fix.course, speed: fix.speed,
+                           timestamp: clock)
+        nav.update(f)
+        for _ in 0..<5 { await Task.yield() }
+        while nav.isRerouting { try? await Task.sleep(for: .milliseconds(5)) }
+    }
+
+    /// Forward along the line to 1,500 m, then a U-turn and back.
+    private func wrongWay(_ nav: NavigationModel) async {
+        for m in stride(from: 0.0, through: 1500, by: 15) {
+            await feed(nav, Fixture.movingFix(Fixture.north(m), course: 0, speed: 15))
+        }
+        for m in stride(from: 1485.0, through: 1300, by: -15) {
+            await feed(nav, Fixture.movingFix(Fixture.north(m), course: 180, speed: 15))
+        }
+    }
+
+    /// Forward to 2,000 m, then east off the line onto a road that is not on it.
+    private func offRoute(_ nav: NavigationModel) async {
+        for m in stride(from: 0.0, through: 2000, by: 15) {
+            await feed(nav, Fixture.movingFix(Fixture.north(m), course: 0, speed: 15))
+        }
+        let corner = Fixture.north(2000)
+        for e in stride(from: 15.0, through: 450, by: 15) {
+            let p = CLLocationCoordinate2D(latitude: corner.latitude,
+                                           longitude: corner.longitude
+                                               + e / (111_320.0 * cos(corner.latitude * .pi / 180)))
+            await feed(nav, Fixture.movingFix(p, course: 90, speed: 15))
+        }
+    }
+
+    func test_shots() async throws {
+        var nav = model(RouteService.ServiceError.server("no route found"), reachable: true)
+        await wrongWay(nav)
+        try render(nav, "wrong-way")
+
+        nav = model(RouteService.ServiceError.offline, reachable: false)
+        await wrongWay(nav)
+        try render(nav, "wrong-way-no-signal")
+
+        nav = model(RouteService.ServiceError.offline, reachable: false)
+        await offRoute(nav)
+        try render(nav, "off-route-no-signal")
+
+        nav = model(RouteService.ServiceError.unreachable(530), reachable: true)
+        await offRoute(nav)
+        try render(nav, "off-route-server-down")
+
+        nav = model(RouteService.ServiceError.server("no route found"), reachable: true)
+        await offRoute(nav)
+        try render(nav, "off-route-connected")
+    }
+}
